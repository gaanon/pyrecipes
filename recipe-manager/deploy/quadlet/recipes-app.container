[Unit]
Description=Recipe Manager - App
Requires=recipes-db.service
After=recipes-db.service

[Container]
ContainerName=recipes-app
Image=localhost/recipe-manager:latest
Network=recipes.network
PublishPort=8010:8000
EnvironmentFile=%h/recipes/app.env
Environment=PYTHONPATH=/code
Volume=%h/recipes/uploads:/code/uploads:Z
Volume=%h/recipes/backups:/code/backups:Z
Volume=%h/.config/rclone:/root/.config/rclone:Z
# Calls /healthz, which checks the app and its database connection. A script, not a
# python -c one-liner: Quadlet mangles quotes inside HealthCmd
HealthCmd=python -m app.healthcheck
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s
# Stop a container that stays unhealthy; Restart=always below starts a fresh one
HealthOnFailure=kill

[Service]
Restart=always

[Install]
WantedBy=default.target
