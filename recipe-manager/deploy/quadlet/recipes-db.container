[Unit]
Description=Recipe Manager - MySQL

[Container]
ContainerName=recipes-db
Image=docker.io/library/mysql:8.0
Network=recipes.network
Volume=recipes-db.volume:/var/lib/mysql
EnvironmentFile=%h/recipes/db.env
# TCP (127.0.0.1), not the socket (localhost): during first-start setup MySQL runs a temporary
# server on the socket only, which must not count as ready
HealthCmd=mysqladmin ping -h 127.0.0.1 --silent
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=30s
# systemd only reports the unit as started once the healthcheck passes (Podman >= 5.0)
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
