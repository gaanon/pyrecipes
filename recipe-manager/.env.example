# Local development settings for docker-compose.yml. Copy to .env (git-ignored) and adjust.
# Every value is optional: docker-compose.yml has a default for each.

# Ports on this machine
APP_PORT=8010
DB_PORT=3306

# Dev database. Changing these only takes effect on a fresh volume
# (docker compose down -v deletes the dev data).
MYSQL_DATABASE=recipe_db
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=rootpassword

# AI recipe scanner (any OpenAI-compatible provider)
AI_API_BASE_URL=https://api.orbit.dev.clearroute.io/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60
